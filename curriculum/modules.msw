# Application behavior, not a list of renamed JavaScript fragments.
(module MathWebModules
  (use Catalog "MathWebCatalog" "../curriculum/catalog.js")
  (use M "GraphMath" "../graph/math.js")
  (use I "GraphInsight" "../graph/insight.js")
  (use Study "GraphStudy" "../graph/study.js")
  (use Render "GraphRender" "../graph/render.js")
  (fn letter (c) (return (or (and (>= c "a") (<= c "z")) (and (>= c "A") (<= c "Z")))))
  (fn replaceSymbol (source symbol replacement)
    (let out "") (let i 0)
    (while (< i (length source))
      (let c (slice source i (+ i 1)))
      (let left (choose (= i 0) "" (slice source (- i 1) i))) (let right (slice source (+ i 1) (+ i 2)))
      (set out (+ out (choose (and (= c symbol) (and (not (letter left)) (not (letter right)))) replacement c)))
      (set i (+ i 1))) (return out))
  (fn transformed (source)
    (let parsed ((get M "parse") source)) (let kind (get parsed "kind"))
    (if (= kind "function")
      (let pieces (split source "{")) (let body (get pieces 0))
      (let condition (choose (> (length pieces) 1) (+ " {" (replaceSymbol (get pieces 1) "x" "(x-h)")) ""))
      (return (+ (join (array "a*(" (replaceSymbol body "x" "(x-h)") ")+k") "") condition)))
    (if (= kind "implicit") (return (replaceSymbol (replaceSymbol source "x" "((x-h)/a)") "y" "((y-k)/a)")))
    (if (= kind "parametric")
      (return (join (array "(a*(" ((get I "expression") parsed 0) ")+h,a*(" ((get I "expression") parsed 1) ")+k)") "")))
    (if (= kind "polar")
      (let radius ((get I "expression") parsed 0))
      (return (join (array "(a*(" radius ")*cos(t)+h,a*(" radius ")*sin(t)+k)") "")))
    (fail "不支援的實驗圖形。"))
  (fn control (key label low high initial step)
    (return (record ("key" key) ("label" label) ("min" low) ("max" high) ("value" initial) ("step" step) ("integer" false))))
  (fn point (x y label color) (return (record ("x" x) ("y" y) ("label" label) ("color" color))))
  (fn line (a b color dash) (return (record ("a" a) ("b" b) ("color" color) ("dash" dash))))
  (fn create (drawScene)
    (let modules (array))
    (each group (get Catalog "groups")
      (let i 0)
      (each item (get group "items")
        (set i (+ i 1))
        (let source (transformed (get item "source"))) (let parsed ((get M "parse") source))
        (let kind (get parsed "kind")) (let title (+ (+ (get group "title") " · ") (get item "name")))
        (fn compute (state)
          (let params (record ("a" (get state "a")) ("h" (get state "h")) ("k" (get state "k"))))
          (let u (get state "u")) (let curves (array)) (let points (array)) (let lines (array)) (let info (array))
          (let results (record)) (let scene (record ("x" (array -8 8)) ("y" (array -8 8)) ("equal" true) ("curves" curves) ("points" points) ("lines" lines)))
          (fn at (x) (let y ((get parsed "at") x none params)) (return (choose (finite y) y (/ 0 0))))
          (let note "改變平移 h、k 與尺度 a；畫面只顯示有限範圍。")
          (if (= kind "function")
            (let y (at u)) (let slope ((get parsed "derivative") u params))
            (push curves (record ("f" at) ("color" "#4f46e5")))
            (put results "value" (choose (finite y) y none)) (put results "slope" (choose (finite slope) slope none))
            (push info (+ (+ (+ "f(" (str u)) ") ≈ ") ((get Study "fmt") y)))
            (push info (+ "導數 ≈ " ((get Study "fmt") slope)))
            (if (finite y)
              (push points (point u y "觀察點" "#db6b28"))
              (if (finite slope)
                (fn tangent (x) (return (+ y (* slope (- x u)))))
                (push curves (record ("f" tangent) ("color" "#db6b28")))))
            (let features ((get Study "features") parsed params))
            (each hole (get features "holes") (let p (point (get hole "x") (get hole "y") "破洞" "#4f46e5")) (put p "open" true) (push points p))
            (each x (get features "poles") (push lines (line (point x -8 "" "#9b4cc2") (point x 8 "" "#9b4cc2") "#9b4cc2" true)))
            (let horizontal (get features "horizontal"))
            (if (!= horizontal none) (push lines (line (point -8 horizontal "" "#9b4cc2") (point 8 horizontal "" "#9b4cc2") "#9b4cc2" true)))
            (set note "紫色為函數，橘色為觀察點切線（若有限導數存在）；空心點為已辨識破洞。"))
          (if (!= kind "function")
            (let viewport (record ("xmin" -8) ("xmax" 8) ("ymin" -8) ("ymax" 8) ("width" 640) ("height" 480)))
            (let sampled none)
            (if (= kind "implicit")
              (fn field (x y) (return ((get parsed "at") x y params)))
              (set sampled ((get Render "contourImplicit") field viewport (record ("quality" "interactive"))))
              (let residual (field u (get state "k"))) (put results "residual" (choose (finite residual) residual none))
              (push info (+ "觀察点代入左式−右式 ≈ " ((get Study "fmt") residual)))
              (push points (point u (get state "k") "檢查點" "#db6b28"))
              (set note "橘點是檢查點，未必在曲線上；代入殘差等於零才滿足方程。")
              (else
                (fn position (t) (return ((get parsed "at") t none params)))
                (set sampled ((get Render "sampleParametric") position 0 6.283185307179586 viewport (record ("quality" "interactive"))))
                (let p (position u)) (put results "x" (get p 0)) (put results "y" (get p 1))
                (if (and (finite (get p 0)) (finite (get p 1))) (push points (point (get p 0) (get p 1) "參數位置" "#db6b28")))
                (push info (join (array "t = " (str u) "；位置 (" ((get Study "fmt") (get p 0)) ", " ((get Study "fmt") (get p 1)) ")") ""))
                (set note "參數曲線僅顯示 t ∈ [0, 2π]；橘點標示目前參數位置。")))
            (each segment (get sampled "segments")
              (let j 1)
              (while (< j (length segment))
                (let p (get segment (- j 1))) (let q (get segment j))
                (push lines (line (point (get p 0) (get p 1) "" "#4f46e5") (point (get q 0) (get q 1) "" "#4f46e5") "#4f46e5" false))
                (set j (+ j 1)))))
          (put scene "note" note)
          (let formula (array (+ "原始式：" (get item "source")) (+ "目前式：" source) (join (array "a = " (str (get state "a")) "；h = " (str (get state "h")) "；k = " (str (get state "k"))) "")))
          (each text info (push formula text))
          (return (record ("results" results) ("lines" formula) ("scene" scene) ("summary" (join info "；")) ("graphRows" (array (record ("text" source) ("label" title) ("visible" true)))) ("params" params))))
        (fn draw (state model) (drawScene (get model "scene") title))
        (fn formula (state model) (return (get model "lines")))
        (fn status (state model) (return (get model "summary")))
        (push modules (record
          ("id" (join (array "hs-" (get group "id") "-" (str i)) "")) ("short" title) ("title" title) ("tag" (get group "tag"))
          ("controls" (array (control "a" (choose (= kind "function") "縱向尺度 a" "幾何尺度 a") 0.5 2 1 0.1) (control "h" "水平平移 h" -3 3 0 0.1) (control "k" "垂直平移 k" -3 3 0 0.1)
            (control "u" (choose (= kind "parametric") "觀察參數 t" "觀察橫座標") (choose (= kind "parametric") 0 -6) (choose (= kind "parametric") 6.283185307179586 6) 1 0.1)))
          ("graphSource" source) ("compute" compute) ("draw" draw) ("formula" formula) ("status" status) ("examSignal" (get group "signal")) ("trap" (get group "trap")) ("challenge" (get group "challenge"))
          ("prompt" (+ (+ "先預測「" (get item "name")) "」的圖形，再一次只改一個參數，核對算式與觀察點。")) ("course" "common") ("sourceLanguage" "MathScript Web 0.1") ("family" (get group "id"))))))
    (return modules))
  (export (record ("create" create) ("transformed" transformed) ("replaceSymbol" replaceSymbol))))
