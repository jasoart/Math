# Tool definitions and dispatch are compiled from this source; DOM is a host adapter.
(module MathWebTools
  (use Study "GraphStudy" "../graph/study.js")
  (fn number (key label initial)
    (return (record ("key" key) ("label" label) ("type" "number") ("value" initial))))
  (fn select (key label options initial)
    (return (record ("key" key) ("label" label) ("type" "select") ("options" options) ("value" initial))))
  (let tools (array
    (record ("id" "sign") ("name" "方程與不等式符號表") ("curve" true) ("description" "分割零點與分母禁點，列出區間內的完整解集。支援分子、分母與禁點條件不超過二次的有理式。")
      ("fields" (array (number "a" "區間起點" -5) (number "b" "區間終點" 5)
        (select "relation" "比較關係" (array ">=" ">" "<=" "<" "=" "!=") ">=")
        (record ("key" "other") ("label" "比較對象") ("type" "curve") ("value" "")))))
    (record ("id" "variation") ("name" "增減與局部極值") ("curve" true) ("description" "以導數符號判定增減與變號極值；遇到結構過於複雜的式子會明確提示。") ("fields" (array (number "a" "區間起點" -5) (number "b" "區間終點" 5))))
    (record ("id" "limits") ("name" "左右極限觀察台") ("curve" true) ("description" "逐層縮小左右距離，比較極限趨勢與函數值。數值表是觀察證據，不能代替一般極限證明。") ("fields" (array (number "x" "趨近位置" 1) (number "step" "起始距離" 0.1))))
    (record ("id" "tangent") ("name" "割線、切線與法線") ("curve" true) ("description" "從兩點的平均變化率走向自動微分；新增的線與點仍可直接編輯。") ("fields" (array (number "x" "觀察 x" 1) (number "h" "割線距離 h" 0.5))))
    (record ("id" "transform") ("name" "函數平移與伸縮") ("curve" true) ("description" "建立 a·f(x−h)+k，保留原曲線以便比較；範圍限制需另行处理。") ("fields" (array (number "h" "水平位移 h" 2) (number "k" "垂直位移 k" 1) (number "scale" "縱向倍率 a" 1))))
    (record ("id" "inverse") ("name" "反關係鏡射") ("curve" true) ("description" "交換 x、y，關於 y=x 鏡射。若原函數不是一對一，結果是反關係。") ("fields" (array)))
    (record ("id" "circle") ("name" "圓外切線作圖器") ("curve" false) ("description" "比較圓心距，建立零、一或兩條切線，並列出垂直條件的數值核對。")
      ("fields" (array (number "h" "圓心 x" 0) (number "k" "圓心 y" 0) (number "r" "半徑" 2) (number "px" "P 的 x" 4) (number "py" "P 的 y" 1))))
    (record ("id" "triangle") ("name" "三角形三心實驗室") ("curve" false) ("description" "建立外心、重心、垂心與外接圓，核對三個頂點到外心的距離。")
      ("fields" (array (number "ax" "A 的 x" 0) (number "ay" "A 的 y" 0) (number "bx" "B 的 x" 4) (number "by" "B 的 y" 0) (number "cx" "C 的 x" 1) (number "cy" "C 的 y" 3))))
    (record ("id" "regression") ("name" "資料擬合與殘差") ("curve" false) ("description" "輸入最多 100 筆資料，觀察迴歸直線、R² 及每筆殘差。畫布最多加入前 10 個資料點。")
      ("fields" (array (record ("key" "data") ("label" "每行 x,y") ("type" "text") ("value" "1,2\n2,4\n3,5\n4,8\n5,9")))))
    (record ("id" "riemann") ("name" "黎曼和面積積木") ("curve" true) ("description" "以左端、右端、中點或梯形估計累積量，直接將分割形狀疊在畫布上。")
      ("fields" (array (number "a" "區間起點" 0) (number "b" "區間終點" 2) (number "n" "分割數 1–100" 8) (select "method" "取樣方法" (array "left" "right" "midpoint" "trapezoid") "midpoint"))))))
  (fn run (id source params values other)
    (fn v (key) (return (get values key)))
    (if (= id "sign") (return ((get Study "signChart") source params (v "a") (v "b") (v "relation") other)))
    (if (= id "variation") (return ((get Study "variation") source params (v "a") (v "b"))))
    (if (= id "limits") (return ((get Study "limits") source params (v "x") (v "step"))))
    (if (= id "tangent") (return ((get Study "tangent") source params (v "x") (v "h"))))
    (if (= id "transform") (return ((get Study "transform") source params (v "h") (v "k") (v "scale") false)))
    (if (= id "inverse") (return ((get Study "transform") source params 0 0 1 true)))
    (if (= id "circle") (return ((get Study "circleTangents") (v "h") (v "k") (v "r") (v "px") (v "py"))))
    (if (= id "triangle") (return ((get Study "triangle") (v "ax") (v "ay") (v "bx") (v "by") (v "cx") (v "cy"))))
    (if (= id "regression") (return ((get Study "regression") (v "data"))))
    (if (= id "riemann") (return ((get Study "riemann") source params (v "a") (v "b") (v "n") (v "method"))))
    (fail "未知工具。"))
  (export (record ("tools" tools) ("run" run))))
