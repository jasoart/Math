(record ("id" "inverse-trig") ("title" "反三角函數") ("tag" "三角") ("signal" "同時檢查主值範圍与輸入限制。") ("trap" "arcsin(sin x) 不會在全實數都等於 x。") ("challenge" "觀察主值範圍如何造成折返。") ("kind" "function") ("items" (array (record ("name" "反正弦") ("source" "asin(x)"))
