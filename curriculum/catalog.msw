# 36 families × 9 curated investigations = 324. Each family shares its renderer.
(module MathWebCatalog
  (let groups (array (record ("id" "line") ("title" "直線與截距") ("tag" "代數") ("signal" "以斜率與兩軸截距連結方程和圖形。") ("trap" "斜率的正負與截距的正負是不同概念。") ("challenge" "將 h 加 1，x、y 截距分別如何改變？") ("kind" "function") ("items" (array (record ("name" "單位斜率") ("source" "x"))
(record ("name" "遞減直線") ("source" "-x"))
(record ("name" "兩倍斜率") ("source" "2*x+1"))
(record ("name" "負斜率截距") ("source" "-2*x+3"))
(record ("name" "分數斜率") ("source" "x/2-2"))
(record ("name" "水平直線") ("source" "3"))
(record ("name" "經過第三象限") ("source" "3*x-4"))
(record ("name" "平緩下降") ("source" "-x/3+1"))
(record ("name" "陡峭上升") ("source" "5*x+2")))))
(record ("id" "quadratic-roots") ("title" "二次方程的根") ("tag" "代數") ("signal" "比較與 x 軸的交點數及根的位置。") ("trap" "切觸 x 軸時是重根，不能當作兩個不同交點。") ("challenge" "改變 k，何時有兩根、重根、無實根？") ("kind" "function") ("items" (array (record ("name" "對稱兩根") ("source" "x^2-4"))
(record ("name" "相鄰兩根") ("source" "(x-1)*(x-2)"))
