(record ("name" "餘弦主值") ("source" "acos(cos(x))"))
(record ("name" "反正切相加") ("source" "atan(x)+atan(1/x)")))))
(record ("id" "continuous") ("title" "分段連續性") ("tag" "微積分") ("signal" "先比較分界兩側極限，再核對分界點函數值。") ("trap" "左右圖形接得上，不表示導數也相同。") ("challenge" "把觀察點放在分界，檢查是否有唯一切線。") ("kind" "function") ("items" (array (record ("name" "絕對值分段") ("source" "if(x<0,-x,x)"))
(record ("name" "左右不同冪") ("source" "if(x<0,x,x^2)"))
(record ("name" "折線接平方") ("source" "if(x<1,x,1+(x-1)^2)"))
(record ("name" "平方與立方") ("source" "if(x<0,x^2,x^3)"))
(record ("name" "兩條斜線") ("source" "if(x<2,x,4-x)"))
(record ("name" "平台接斜線") ("source" "if(x<0,0,x)"))
(record ("name" "平方接平台") ("source" "if(x<1,x^2,1)"))
(record ("name" "正弦接直線") ("source" "if(x<0,sin(x),x)"))
(record ("name" "開方接平方") ("source" "if(x<0,-sqrt(-x),x^2)")))))
(record ("id" "discontinuous") ("title" "跳躍與特殊點") ("tag" "微積分") ("signal" "分界點的值、左極限與右極限要分別檢查。") ("trap" "點值改變不一定改變極限；左右極限不同才是跳躍。") ("challenge" "請用左右极限表比較分界位置。") ("kind" "function") ("items" (array (record ("name" "階躍") ("source" "if(x<0,0,1)"))
(record ("name" "斜線跳躍") ("source" "if(x<0,x,x+2)"))
(record ("name" "平方跳躍") ("source" "if(x<1,x^2,x^2+1)"))
(record ("name" "單點補值") ("source" "if(x=0,1,x^2)"))
(record ("name" "單點刪值") ("source" "if(x=1,0,x+1)"))
(record ("name" "兩段常數") ("source" "if(x<2,-1,2)"))
(record ("name" "反向跳躍") ("source" "if(x<0,2,-2)"))
(record ("name" "震盪邊界") ("source" "if(x=0,0,sin(1/x))"))
(record ("name" "有界跳躍") ("source" "if(x<0,atan(x),atan(x)+1)")))))
(record ("id" "steps") ("title" "取整與階梯函數") ("tag" "代數") ("signal" "用開閉端點理解每一段常數。") ("trap" "跳躍位置不適合用連續函數的找根方法。") ("challenge" "區分 floor 與 ceil 在整數點的值。") ("kind" "function") ("items" (array (record ("name" "向下取整") ("source" "floor(x)"))
(record ("name" "向上取整") ("source" "ceil(x)"))
(record ("name" "四捨五入") ("source" "round(x)"))
(record ("name" "符號函數") ("source" "sign(x)"))
(record ("name" "細階梯") ("source" "floor(2*x)/2"))
(record ("name" "粗階梯") ("source" "2*floor(x/2)"))
(record ("name" "小數部分") ("source" "x-floor(x)"))
(record ("name" "對稱階梯") ("source" "floor(abs(x))"))
(record ("name" "平移階梯") ("source" "floor(x+0.5)")))))
(record ("id" "inverse") ("title" "反關係與限制") ("tag" "代數") ("signal" "交換 x、y 前，先檢查原函數是否一對一。") ("trap" "反關係未必能寫成單一 y=f(x)。") ("challenge" "用鏡射工具交換 x、y，哪些會出現多值？") ("kind" "function") ("items" (array (record ("name" "偏移平方") ("source" "(x+1)^2+3"))
(record ("name" "單調立方") ("source" "2*x^3+1"))
(record ("name" "受限平方") ("source" "x^2 {x>=0}"))
