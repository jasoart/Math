(record ("id" "lissajous") ("title" "李沙育與頻率比") ("tag" "三角") ("signal" "用兩軸振盪頻率比理解封閉軌跡。") ("trap" "相位會改變交叉形狀，頻率比不是唯一參數。") ("challenge" "改變 t 的觀察位置，找出軌跡交叉的不同時刻。") ("kind" "parametric") ("items" (array (record ("name" "一比二") ("source" "(sin(t),sin(2*t))"))
(record ("name" "二比三") ("source" "(sin(2*t),sin(3*t))"))
(record ("name" "三比四") ("source" "(sin(3*t),sin(4*t))"))
(record ("name" "一比三") ("source" "(sin(t),sin(3*t))"))
(record ("name" "二比五") ("source" "(sin(2*t),sin(5*t))"))
(record ("name" "相位偏移") ("source" "(sin(2*t+pi/4),sin(3*t))"))
(record ("name" "振幅不等") ("source" "(3*sin(2*t),2*sin(3*t))"))
(record ("name" "餘弦交叉") ("source" "(cos(2*t),sin(3*t))"))
(record ("name" "五比四") ("source" "(2*cos(5*t),2*sin(4*t))")))))
(record ("id" "trajectory") ("title" "參數曲線與軌跡") ("tag" "幾何") ("signal" "分開追蹤 x(t)、y(t)，再解讀平面軌跡。") ("trap" "同一位置可能被多次經過，軌跡不能完整表達速度。") ("challenge" "比較參數式與消去參數後的方程。") ("kind" "parametric") ("items" (array (record ("name" "拋物軌跡") ("source" "(t,t^2/4)"))
(record ("name" "投射軌跡") ("source" "(t,3*t-t^2/2)"))
(record ("name" "螺旋") ("source" "(t*cos(t)/2,t*sin(t)/2)"))
(record ("name" "擺線") ("source" "(t-sin(t),1-cos(t))"))
(record ("name" "心形參數") ("source" "((2*cos(t)-cos(2*t)),(2*sin(t)-sin(2*t)))"))
(record ("name" "星形內擺線") ("source" "(3*cos(t)^3,3*sin(t)^3)"))
(record ("name" "雙曲參數") ("source" "(2*cosh(t/3),sinh(t/3))"))
(record ("name" "有理圓參數") ("source" "((1-t^2)/(1+t^2),2*t/(1+t^2))"))
(record ("name" "指數軌跡") ("source" "(t,exp(-t))")))))
(record ("id" "polar") ("title" "極座標與花瓣") ("tag" "幾何") ("signal" "極徑可為負，先理解方向再讀取圖形。") ("trap" "負極徑代表反方向，不是把點刪掉。") ("challenge" "比較奇、偶倍角與花瓣數；需檢查整段角度。") ("kind" "polar") ("items" (array (record ("name" "等半徑") ("source" "r=2"))
(record ("name" "三瓣玫瑰") ("source" "r=3*cos(3*t)"))
(record ("name" "四瓣玫瑰") ("source" "r=3*cos(2*t)"))
(record ("name" "五瓣玫瑰") ("source" "r=3*sin(5*t)"))
(record ("name" "八瓣玫瑰") ("source" "r=3*sin(4*t)"))
(record ("name" "心形線") ("source" "r=2*(1+cos(t))"))
(record ("name" "向下心形") ("source" "r=2*(1-sin(t))"))
(record ("name" "有內環蝸線") ("source" "r=1+2*cos(t)"))
(record ("name" "阿基米德螺旋") ("source" "r=t/2")))))))
  (export (record ("groups" groups) ("count" 324))))
