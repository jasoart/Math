(record ("id" "hyperbola") ("title" "雙曲線與漸近線") ("tag" "幾何") ("signal" "先辨別實軸方向，再找兩條漸近線。") ("trap" "雙曲線的兩支不應在中間被連接。") ("challenge" "比較雙曲線與漸近線在遠處的距離。") ("kind" "implicit") ("items" (array (record ("name" "左右開口") ("source" "x^2-y^2=1"))
