(record ("name" "旋轉橢圓") ("source" "2*x^2+2*x*y+2*y^2=6")))))
(record ("id" "parabola") ("title" "拋物線與方向") ("tag" "幾何") ("signal" "比較 y²=4px 與 x²=4py 的開口方向。") ("trap" "橫向拋物線不能用單一 y=f(x) 畫完。") ("challenge" "找出頂點、對稱軸及焦點的方向。") ("kind" "implicit") ("items" (array (record ("name" "右開拋物線") ("source" "y^2=4*x"))
