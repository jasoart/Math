(record ("name" "負的重根") ("source" "(x+1)^2"))
(record ("name" "無實零點") ("source" "x^2+2"))
(record ("name" "向下開口") ("source" "-(x-1)*(x+2)"))
(record ("name" "分數根") ("source" "(2*x-1)*(x+2)")))))
