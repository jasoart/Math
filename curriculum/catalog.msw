(record ("name" "分式映射") ("source" "(2*x+1)/(x-3)"))
(record ("name" "受限正弦") ("source" "sin(x) {-pi/2<=x<=pi/2}")))))
(record ("id" "composition") ("title" "複合函數與對稱") ("tag" "代數") ("signal" "由內到外追蹤輸入，再檢查每一層定義域。") ("trap" "f(g(x)) 與 g(f(x)) 通常不同。") ("challenge" "先判斷奇偶性，再以圖形核對。") ("kind" "function") ("items" (array (record ("name" "正弦平方輸入") ("source" "sin(x^2)"))
(record ("name" "平方正弦平移") ("source" "(sin(x)+1)^2"))
(record ("name" "指数平方") ("source" "exp(-x^2)"))
(record ("name" "對數絕對值") ("source" "ln(abs(x)+1)"))
(record ("name" "絕對值正弦") ("source" "abs(sin(x))"))
(record ("name" "平方根正弦") ("source" "sqrt(1+sin(x))"))
(record ("name" "正弦倒數輸入") ("source" "sin(1/(x-1))"))
(record ("name" "反正切平方") ("source" "atan(x^2)"))
(record ("name" "指數正弦") ("source" "exp(sin(x))")))))
(record ("id" "circle") ("title" "圓與平移") ("tag" "幾何") ("signal" "從標準式讀出圓心與半徑。") ("trap" "等比例座標下才會把圓畫成視覺上的圓。") ("challenge" "以圓切線工具檢查圓外一點的兩條切線。") ("kind" "implicit") ("items" (array (record ("name" "單位圓") ("source" "x^2+y^2=1"))
