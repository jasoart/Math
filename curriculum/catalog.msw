(record ("id" "waves") ("title" "波形與包絡") ("tag" "三角") ("signal" "分辨快振盪與緩慢變化的包絡。") ("trap" "包絡不是原波形的另一個週期。") ("challenge" "比較振幅變化速度與零點密度。") ("kind" "function") ("items" (array (record ("name" "拍頻") ("source" "sin(3*x)+sin(4*x)"))
