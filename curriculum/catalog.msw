(record ("id" "param-ellipse") ("title" "參數式的運動方向") ("tag" "幾何") ("signal" "軌跡相同不代表運動方向與速度相同。") ("trap" "參數 t 是時間型參數，不是 x 座標。") ("challenge" "觀察點 t 增加時，軌跡順時針或逆時針？") ("kind" "parametric") ("items" (array (record ("name" "圓周運動") ("source" "(cos(t),sin(t))"))
