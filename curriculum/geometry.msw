# Maintained MathScript Web source for high-school constructions and numerical tools.
(module MathWebGeometry
  (use M "GraphMath" "../graph/math.js")
  (fn fmt (x) (return (choose (finite x) (str x) "未定義")))
  (fn scalar (x)
    (if (or (not (finite x)) (> (abs x) 1000000)) (fail "數值須在 ±1000000 內。")) (return x))
  (fn row (text label) (return (record ("text" text) ("label" label) ("visible" true))))
  (fn point (x y label) (return (row (join (array "(" (str x) "," (str y) ")") "") label)))
  (fn report (title signal steps trap challenge)
    (return (record ("title" title) ("signal" signal) ("steps" steps) ("trap" trap) ("challenge" challenge) ("headers" (array)) ("rows" (array)) ("graphRows" (array)))))
  (fn circleTangents (h k r px py)
    (each v (array h k r px py) (scalar v))
    (if (<= r 0) (fail "半徑必須大於零。"))
    (let dx (- px h)) (let dy (- py k)) (let d2 (+ (* dx dx) (* dy dy))) (let r2 (* r r))
    (let delta (- d2 r2)) (let tolerance (* 0.000000000000014210854715202004 (max d2 r2)))
    (let contacts (array)) (let kind "圓外點：兩條切線")
    (if (< delta (- tolerance)) (set kind "圓內點：沒有實切線")
      (else (if (<= (abs delta) tolerance)
        (if (!= delta 0) (fail "點太接近圓周，精度不足以判斷切線數；請調整座標。"))
        (push contacts (record ("x" px) ("y" py))) (set kind "圓上點：一條切線")
        (else (let base (/ r2 d2)) (let mult (/ (* r (sqrt delta)) d2))
          (push contacts (record ("x" (- (+ h (* base dx)) (* mult dy))) ("y" (+ (+ k (* base dy)) (* mult dx)))))
          (push contacts (record ("x" (+ (+ h (* base dx)) (* mult dy))) ("y" (- (+ k (* base dy)) (* mult dx)))))))))
    (let graphRows (array (row (join (array "(x-(" (str h) "))^2+(y-(" (str k) "))^2=" (str r2)) "") "圓") (point px py "P")))
    (let rows (array)) (let i 0)
    (each q contacts
      (set i (+ i 1)) (let x (get q "x")) (let y (get q "y"))
      (push graphRows (point x y (+ "T" (str i))))
      (push graphRows (row (join (array "(" (str (- x h)) ")*(x-(" (str x) "))+(" (str (- y k)) ")*(y-(" (str y) "))=0") "") (+ "切線 " (str i))))
      (push rows (array x y (+ (pow (- x h) 2) (pow (- y k) 2)) (+ (* (- x h) (- px x)) (* (- y k) (- py y))))))
    (let out (report "過一點作圓的切線" "先比較圓心距與半徑，再決定切線數。"
      (array kind (join (array "OP ≈ " (fmt (sqrt d2)) "；r = " (fmt r)) "") (choose (>= delta 0) (+ "切線段長 √(OP²−r²) ≈ " (fmt (sqrt delta))) "圓內沒有實切線段。"))
      "半徑與切線垂直；不能先假設一定有兩條切線。" "把 P 移到圓上、圓內，切線數如何改變？"))
    (put out "graphRows" graphRows) (put out "contacts" contacts) (put out "rows" rows)
    (put out "headers" (array "切點 x" "切點 y" "半徑平方" "垂直內積")) (return out))
  (fn triangle (ax ay bx by cx cy)
    (each v (array ax ay bx by cx cy) (scalar v))
    (let ux (- bx ax)) (let uy (- by ay)) (let vx (- cx ax)) (let vy (- cy ay))
    (let cross (- (* ux vy) (* uy vx))) (let scale (max (hypot ux uy) (hypot vx vy)))
    (if (or (= scale 0) (<= (abs cross) (* 0.000000000001 (* scale scale)))) (fail "三點共線或太接近共線，無法可靠建立外心。"))
    (let u2 (+ (* ux ux) (* uy uy))) (let v2 (+ (* vx vx) (* vy vy)))
    (let ox (+ ax (/ (- (* u2 vy) (* v2 uy)) (* 2 cross))))
    (let oy (+ ay (/ (- (* ux v2) (* vx u2)) (* 2 cross))))
    (let gx (/ (+ (+ ax bx) cx) 3)) (let gy (/ (+ (+ ay by) cy) 3))
    (let hx (- (+ (+ ax bx) cx) (* 2 ox))) (let hy (- (+ (+ ay by) cy) (* 2 oy)))
    (let radius (hypot (- ox ax) (- oy ay)))
    (each v (array ox oy hx hy radius) (scalar v))
    (let graphRows (array (point ax ay "A") (point bx by "B") (point cx cy "C") (point ox oy "外心 O") (point gx gy "重心 G") (point hx hy "垂心 H")
      (row (join (array "(x-(" (str ox) "))^2+(y-(" (str oy) "))^2=" (str (* radius radius))) "") "外接圓")))
    (let ps (array (array ax ay) (array bx by) (array cx cy))) (let rows (array)) (let i 0)
    (while (< i 3)
      (let p (get ps i)) (let q (get ps (% (+ i 1) 3)))
      (push graphRows (row (join (array "(" (str (get p 0)) "+(" (str (- (get q 0) (get p 0))) ")*t," (str (get p 1)) "+(" (str (- (get q 1) (get p 1))) ")*t) {0<=t<=1}") "") (+ "邊 " (str (+ i 1)))))
      (push rows (array (get (array "A" "B" "C") i) (hypot (- (get p 0) ox) (- (get p 1) oy)))) (set i (+ i 1)))
    (let out (report "三角形三心與外接圓" "外心等距，重心取座標平均，再求垂心。"
      (array (+ "面積 ≈ " (fmt (/ (abs cross) 2))) (join (array "外心 O=(" (fmt ox) ", " (fmt oy) ")；外接圓半徑 ≈ " (fmt radius)) "")
        (join (array "重心 G=(" (fmt gx) ", " (fmt gy) ")；垂心 H=(" (fmt hx) ", " (fmt hy) ")") ""))
      "鈍角三角形的外心、垂心可能在外部；共線三點無唯一外接圓。" "把一個角變為直角，外心落在哪裡？"))
    (put out "area" (/ (abs cross) 2)) (put out "centers" (record ("O" (array ox oy)) ("G" (array gx gy)) ("H" (array hx hy))))
    (put out "graphRows" graphRows) (put out "t" (array 0 1)) (put out "headers" (array "頂點" "至外心距離")) (put out "rows" rows) (return out))
  (fn parseData (text)
    (if (> (length text) 8000) (fail "資料最多 8000 字。"))
    (let lines (split (replace text ";" "\n") "\n")) (let data (array)) (let line 0)
    (each raw lines
      (set line (+ line 1)) (let s (trim raw))
      (if (> (length s) 0)
        (let words (split (replace (replace (replace s "，" " ") "," " ") "\t" " ") " ")) (let pair (array))
        (each word words
          (if (> (length word) 0)
            (let i 0)
            (while (< i (length word))
              (let c (slice word i (+ i 1)))
              (if (not (or (and (>= c "0") (<= c "9")) (or (or (= c "+") (= c "-")) (or (= c ".") (or (= c "e") (= c "E")))))) (fail (+ "資料格式錯誤，行 " (str line))))
              (set i (+ i 1)))
            (push pair (scalar (num word)))))
        (if (!= (length pair) 2) (fail (+ "每行需兩個數值，行 " (str line))))
        (push data pair)))
    (if (or (< (length data) 2) (> (length data) 100)) (fail "請輸入 2～100 筆 x,y 資料。")) (return data))
  (fn regression (text)
    (let data (parseData text)) (let n (length data)) (let mx 0) (let my 0)
    (each p data (set mx (+ mx (/ (get p 0) n))) (set my (+ my (/ (get p 1) n))))
    (let xx 0) (let xy 0) (let yy 0)
    (each p data (let x (- (get p 0) mx)) (let y (- (get p 1) my))
      (set xx (+ xx (* x x))) (set xy (+ xy (* x y))) (set yy (+ yy (* y y))))
    (if (= xx 0) (fail "所有 x 相同，無法辨識迴歸斜率。"))
    (let slope (/ xy xx)) (let intercept (- my (* slope mx))) (let sse 0) (let rows (array))
    (each p data (let y (+ (* slope (get p 0)) intercept)) (let residual (- (get p 1) y))
      (set sse (+ sse (* residual residual))) (push rows (array (get p 0) (get p 1) y residual)))
    (each x (array slope intercept sse) (if (not (finite x)) (fail "資料尺度無法可靠擬合。")))
    (let r2 (choose (= yy 0) none (max 0 (min 1 (- 1 (/ sse yy))))))
    (let expression (join (array "y=(" (str slope) ")*x+(" (str intercept) ")") ""))
    (let graphRows (array (row expression "迴歸直線"))) (let i 0)
    (each p (slice data 0 10) (set i (+ i 1)) (push graphRows (point (get p 0) (get p 1) (+ "資料 " (str i)))))
    (let out (report "資料擬合與殘差" "先中心化資料，以平方離差與共變量求斜率。"
      (array (+ "樣本數 " (str n)) expression (join (array "殘差平方和 ≈ " (fmt sse) "；R² " (choose (= r2 none) "未定義（所有 y 相同）" (fmt r2))) "")
        (choose (> n 10) "畫布繪出前 10 點；完整資料保留於下表與 CSV。" "全部資料點可加入畫布。"))
      "相關不代表因果；R² 高也不保證外推可靠。" "移動一個離群值，比較斜率與殘差。"))
    (put out "slope" slope) (put out "intercept" intercept) (put out "sse" sse) (put out "r2" r2)
    (put out "rows" rows) (put out "headers" (array "x" "y" "預測值" "殘差")) (put out "graphRows" graphRows) (return out))
  (fn riemann (source params a b n method)
    (scalar a) (scalar b)
    (if (or (<= b a) (< (- b a) 0.000000001)) (fail "終點須大於起點，區間寬至少 10⁻⁹。"))
    (if (or (not (integer n)) (or (< n 1) (> n 100))) (fail "分割數需為 1～100 整數。"))
    (let methodNames (record ("left" "左端點") ("right" "右端點") ("midpoint" "中點") ("trapezoid" "梯形")))
    (if (= (get methodNames method) none) (fail "不支援的取樣方式。"))
    (let f ((get M "parse") source)) (if (!= (get f "kind") "function") (fail "請選擇 y=f(x)。"))
    (fn at (x) (return ((get f "at") x none params)))
    (let h (/ (- b a) n)) (let rectangles (array)) (let rows (array)) (let sum 0) (let i 0)
    (while (< i n)
      (let x0 (+ a (* i h))) (let x1 (choose (= i (- n 1)) b (+ a (* (+ i 1) h))))
      (let p (choose (= method "left") x0 (choose (= method "right") x1 (/ (+ x0 x1) 2))))
      (let y0 (at x0)) (let y1 (at x1)) (let height (choose (= method "trapezoid") (/ (+ y0 y1) 2) (at p)))
      (if (not (finite height)) (fail "取樣點未定義；請檢查定義域。"))
      (let area (* h height)) (set sum (+ sum area))
      (if (not (finite sum)) (fail "累積值溢位，請縮小範圍。"))
      (push rows (array (+ i 1) x0 x1 height area))
      (push rectangles (record ("x0" x0) ("x1" x1) ("y0" (choose (= method "trapezoid") y0 height)) ("y1" (choose (= method "trapezoid") y1 height))))
      (set i (+ i 1)))
    (let reference ((get M "integrate") at a b))
    (let approximation (choose (and (get reference "converged") (finite (get reference "value"))) (get reference "value") none))
    (let out (report "黎曼和與定積分" "每段寬度乘取樣高度，加總為有正負的累積量。"
      (array (join (array "Δx = " (fmt h) "；" (str n) " 等分；" (get methodNames method)) "") (+ "近似和 ≈ " (fmt sum))
        (choose (= approximation none) "參考積分未收斂，不能用來比較誤差。" (join (array "自適應積分參考 ≈ " (fmt approximation) "；差 ≈ " (fmt (- sum approximation))) "")))
      "參考積分仍是數值近似；取樣沒碰到奇異點不代表函數連續。負高度保留負號。" "將分割數加倍，比較四種取樣方法。"))
    (put out "headers" (array "第幾段" "起點" "終點" "代表高度" "有向面積")) (put out "rows" rows) (put out "value" sum)
    (put out "reference" approximation) (put out "rectangles" rectangles) (return out))
  (export (record ("circleTangents" circleTangents) ("triangle" triangle) ("regression" regression) ("parseData" parseData) ("riemann" riemann))))
