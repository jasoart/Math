# MathScript Web 0.2 compiler, implemented in MathScript Web.
# Parenthesized forms are our concrete syntax, not a JavaScript escape hatch.
(module MathWebCompiler
  (fn value (node) (return (get node "value")))
  (fn kind (node) (return (get node "type")))
  (fn includes (items item)
    (each x items (if (= x item) (return true))) (return false))
  (fn identifier (s)
    (if (= (length s) 0) (return false))
    (let i 0)
    (while (< i (length s))
      (let c (slice s i (+ i 1)))
      (if (not (or (= c "_") (or (and (>= c "a") (<= c "z")) (or (and (>= c "A") (<= c "Z")) (and (> i 0) (and (>= c "0") (<= c "9"))))))) (return false))
      (set i (+ i 1)))
    (return true))
  (fn digit (c) (return (and (>= c "0") (<= c "9"))))
  (fn decimal (s)
    (let i 0) (let digits 0)
    (if (= (slice s 0 1) "-") (set i 1))
    (while (and (< i (length s)) (digit (slice s i (+ i 1)))) (set i (+ i 1)) (set digits (+ digits 1)))
    (if (= (slice s i (+ i 1)) ".")
      (set i (+ i 1))
      (while (and (< i (length s)) (digit (slice s i (+ i 1)))) (set i (+ i 1)) (set digits (+ digits 1))))
    (if (= digits 0) (return false))
    (if (includes (array "e" "E") (slice s i (+ i 1)))
      (set i (+ i 1)) (set digits 0)
      (if (includes (array "+" "-") (slice s i (+ i 1))) (set i (+ i 1)))
      (while (and (< i (length s)) (digit (slice s i (+ i 1)))) (set i (+ i 1)) (set digits (+ digits 1)))
      (if (= digits 0) (return false)))
    (return (= i (length s))))
  (fn compile (source)
    (if (> (length source) 120000) (fail "原始碼上限為 120000 字。"))
    (let pos 0) (let line 1) (let col 1) (let nodes 0)
    (fn bad (message at)
      (fail (+ (+ (+ (+ (+ "第 " (str (choose (= at none) line (get at "line")))) " 行，第 ") (str (choose (= at none) col (get at "col")))) " 欄：") message)))
    (fn char () (return (choose (< pos (length source)) (slice source pos (+ pos 1)) "")))
    (fn advance ()
      (let c (char)) (set pos (+ pos 1))
      (if (= c "\n") (set line (+ line 1)) (set col 1) (else (set col (+ col 1))))
      (return c))
    (fn whitespace (c) (return (includes (array " " "\n" "\r" "\t") c)))
    (fn space ()
      (while (< pos (length source))
        (let c (char))
        (if (whitespace c) (advance)
          (else (if (= c "#")
            (while (and (< pos (length source)) (!= (char) "\n")) (advance))
            (else (return none))))))
      (return none))
    (fn node (type val at) (return (record ("type" type) ("value" val) ("line" (get at "line")) ("col" (get at "col")))))
    (fn read (depth)
      (space) (set nodes (+ nodes 1))
      (if (or (> nodes 30000) (> depth 100)) (bad "語法樹超出上限。" none))
      (let at (record ("line" line) ("col" col))) (let c (char))
      (if (= c "") (bad "非預期的檔案結尾。" at))
      (if (= c "(")
        (advance) (let items (array)) (space)
        (while (and (< pos (length source)) (!= (char) ")")) (push items (read (+ depth 1))) (space))
        (if (!= (char) ")") (bad "缺少右括號。" at))
        (advance) (return (node "list" items at)))
      (if (= c ")") (bad "多餘的右括號。" at))
      (if (= c "\"")
        (let raw (advance)) (let closed false)
        (while (and (< pos (length source)) (not closed))
          (set c (advance)) (set raw (+ raw c))
          (if (= c "\\") (if (< pos (length source)) (set raw (+ raw (advance))))
            (else (if (= c "\"") (set closed true)))))
        (if (not closed) (bad "字串未結束。" at))
        (return (node "string" (parseJson raw) at)))
      (let token "")
      (while (and (< pos (length source)) (not (or (whitespace (char)) (includes (array "(" ")" "#") (char)))))
        (set token (+ token (advance))))
      (let first (slice token 0 1))
      (if (decimal token)
        (if (not (finite (num token))) (bad "數字必須有限。" at))
        (return (node "number" (num token) at)))
      (return (node "name" token at)))
    (let tree (read 0)) (space)
    (if (!= pos (length source)) (bad "只能有一個 module。" none))
    (let builtin (split "get put length push pop slice join split trim replace json parseJson str num keys isArray finite integer floor ceil round abs sqrt pow sin cos tan log exp min max hypot fail" " "))
    (let operators (record ("+" "+") ("-" "-") ("*" "*") ("/" "/") ("%" "%") ("=" "===") ("!=" "!==") ("<" "<") (">" ">") ("<=" "<=") (">=" ">=") ("and" "&&") ("or" "||")))
    (fn name (n)
      (if (or (= n none) (or (!= (kind n) "name") (or (not (identifier (value n))) (includes (array "true" "false" "none") (value n))))) (bad "需要合法名稱。" n))
      (return (+ "$" (value n))))
    (fn form (n)
      (if (or (= n none) (or (!= (kind n) "list") (= (length (value n)) 0))) (bad "需要非空的表達式。" n))
      (return (value n)))
    (fn arity (n low high)
      (let size (- (length (value n)) 1))
      (if (or (< size low) (> size high)) (bad "參數個數不符。" n)))
    (fn rangeSpec (n)
      (arity n 2 2)
      (let spec (form (get (value n) 1)))
      (if (or (< (length spec) 3) (> (length spec) 4)) (bad "區間格式為 (索引 起點 終點 [步長])。" (get (value n) 1)))
      (name (get spec 0)) (return spec))
    (fn location (n)
      (return (json (join (array "第 " (str (get n "line")) " 行，第 " (str (get n "col")) " 欄") ""))))
    (fn expressions (items)
      (let out (array)) (each n items (push out (expr n))) (return out))
    (fn names (items)
      (let out (array)) (each n items (push out (name n))) (return out))
    (fn expr (n)
      (if (or (= (kind n) "string") (= (kind n) "number")) (return (json (value n))))
      (if (= (kind n) "name")
        (if (= (value n) "none") (return "null"))
        (if (includes (array "true" "false") (value n)) (return (value n)))
        (return (name n)))
      (let a (form n)) (let head (get a 0)) (let h (value head))
      (if (includes (array "sum-range" "product-range" "collect-range") h)
        (let spec (rangeSpec n))
        (return (join (array "R.range(" (json (get (split h "-") 0)) "," (expr (get spec 1)) "," (expr (get spec 2)) ","
          (choose (= (length spec) 4) (expr (get spec 3)) "1") ",(" (name (get spec 0)) ")=>R.run(()=>{R.tick();return "
          (expr (get a 2)) ";})," (location n) ")") "")))
      (if (= h "assert-math")
        (arity n 2 2)
        (return (join (array "R.assertMath(" (expr (get a 1)) "," (expr (get a 2)) "," (location n) ")") "")))
      (if (= h "array") (return (+ (+ "[" (join (expressions (slice a 1 none)) ",")) "]")))
      (if (= h "record")
        (let pairs (array))
        (each pair (slice a 1 none)
          (let p (form pair))
          (if (or (!= (length p) 2) (or (!= (kind (get p 0)) "string") (includes (array "__proto__" "prototype" "constructor" "caller" "callee" "arguments") (value (get p 0))))) (bad "紀錄需要安全的字串鍵及值。" pair))
          (push pairs (+ (+ (+ (+ "[" (expr (get p 0))) ",") (expr (get p 1))) "]")))
        (return (+ (+ "R.record([" (join pairs ",")) "])")))
      (let operator (choose (= (kind head) "name") (get operators h) none))
      (if (!= operator none)
        (arity n (choose (= h "-") 1 2) 2)
        (return (+ (+ (+ "(" (choose (= (length a) 2) operator "")) (join (expressions (slice a 1 none)) operator)) ")")))
      (if (= h "not") (arity n 1 1) (return (+ (+ "(!" (expr (get a 1))) ")")))
      (if (= h "choose") (arity n 3 3) (return (+ (+ (+ (+ (+ (+ "(" (expr (get a 1))) "?") (expr (get a 2))) ":") (expr (get a 3))) ")")))
      (if (= h "lambda")
        (arity n 2 2) (let p (get a 1))
        (if (!= (kind p) "list") (bad "函式需要參數列。" p))
        (return (+ (+ (+ (+ "(" (join (names (value p)) ",")) ")=>R.run(()=>{R.tick();return ") (expr (get a 2))) ";})")))
      (if (includes (split "module use fn let set if else while each return export" " ") h) (bad "此語句不可放在表達式中。" n))
      (let callee (choose (and (= (kind head) "name") (includes builtin h)) (+ "R." h) (expr head)))
      (return (+ (+ (+ (+ "(" callee) ")(") (join (expressions (slice a 1 none)) ",")) ")")))
    (fn block (items inFn)
      (let out (array)) (each n items (push out (statement n inFn))) (return (join out "\n")))
    (fn statement (n inFn)
      (let a (form n)) (let h (value (get a 0)))
      (if (= h "fn")
        (arity n 3 30000) (let p (get a 2))
        (if (!= (kind p) "list") (bad "函式需要參數列。" p))
        (return (+ (+ (+ (+ (+ (+ "function " (name (get a 1))) "(") (join (names (value p)) ",")) "){return R.run(()=>{R.tick();\n") (block (slice a 3 none) true)) "\n});}")))
      (if (or (= h "let") (= h "set"))
        (arity n 2 2)
        (return (+ (+ (+ (+ (choose (= h "let") "let " "") (name (get a 1))) "=") (expr (get a 2))) ";")))
      (if (= h "return")
        (arity n 1 1) (if (not inFn) (bad "return 只能在函式內。" n))
        (return (+ (+ "return " (expr (get a 1))) ";")))
      (if (= h "if")
        (arity n 2 30000) (let yes (slice a 2 none)) (let no (array)) (let last (get yes (- (length yes) 1)))
        (if (and (= (kind last) "list") (> (length (value last)) 0))
          (if (= (value (get (value last) 0)) "else") (set no (slice (value last) 1 none)) (set yes (slice yes 0 (- (length yes) 1)))))
        (return (+ (+ (+ (+ (+ "if(" (expr (get a 1))) "){\n") (block yes inFn)) "\n}") (choose (> (length no) 0) (+ (+ "else{\n" (block no inFn)) "\n}") ""))))
      (if (= h "while")
        (arity n 2 30000)
        (return (+ (+ (+ (+ "while(" (expr (get a 1))) "){R.tick();\n") (block (slice a 2 none) inFn)) "\n}")))
      (if (= h "each")
        (arity n 3 30000)
        (return (+ (+ (+ (+ (+ (+ "for(const " (name (get a 1))) " of ") (expr (get a 2))) "){R.tick();\n") (block (slice a 3 none) inFn)) "\n}")))
      (if (includes (array "export" "use" "module" "else") h) (bad "語句位置錯誤。" n))
      (return (+ (expr n) ";")))
    (let top (form tree))
    (if (or (!= (value (get top 0)) "module") (< (length top) 3)) (bad "程式須以 (module 名稱 …) 開始。" tree))
    (let moduleName (slice (name (get top 1)) 1 none))
    (if (includes (split "constructor prototype __proto__ window document globalThis self eval Function Object Array String Number Boolean JSON Math Date Promise fetch require module exports" " ") moduleName) (bad "此模組名称為保留名稱。" (get top 1))) (let imports (array)) (let body (array)) (let exported none)
    (each n (slice top 2 none)
      (let a (form n)) (let h (value (get a 0)))
      (if (= h "use")
        (arity n 3 3) (let binding (name (get a 1))) (let global (get a 2)) (let path (get a 3))
        (if (or (!= (kind global) "string") (not (identifier (value global)))) (bad "use 需要全域名稱及 ../ 內的模組路徑。" n))
        (if (!= (kind path) "string") (bad "use 需要全域名稱及 ../ 內的模組路徑。" n))
        (let p (value path))
        (if (or (!= (slice p 0 3) "../") (!= (slice p (- (length p) 3) none) ".js")) (bad "use 需要全域名稱及 ../ 內的模組路徑。" n))
        (let j 3)
        (while (< j (- (length p) 3))
          (let c (slice p j (+ j 1)))
          (if (not (or (identifier c) (or (and (>= c "0") (<= c "9")) (includes (array "/" "-") c)))) (bad "use 需要全域名稱及 ../ 內的模組路徑。" n))
          (set j (+ j 1)))
        (let allowedImports (record ("GraphMath" "../graph/math.js") ("GraphInsight" "../graph/insight.js") ("GraphStudy" "../graph/study.js") ("GraphRender" "../graph/render.js") ("MathWebCatalog" "../curriculum/catalog.js") ("MathWebGeometry" "../curriculum/geometry.js")))
        (if (!= (get allowedImports (value global)) p) (bad "use 只能使用受支援的宿主模組。" n))
        (push imports (record ("binding" binding) ("global" (value global)) ("path" p)))
        (else (if (= h "export")
          (arity n 1 1) (if (!= exported none) (bad "export 只能出現一次。" n)) (set exported (expr (get a 1)))
          (else (push body n))))))
    (if (= exported none) (bad "缺少 export。" tree))
    # Lexical binding validation: no implicit JavaScript globals or duplicate locals.
    (fn known (scopes word)
      (each scope scopes (if (includes scope word) (return true))) (return false))
    (fn declare (scope n)
      (name n)
      (if (includes scope (value n)) (bad (+ "名稱重複：" (value n)) n))
      (push scope (value n)))
    (fn checkExpr (n scopes)
      (if (= (kind n) "name")
        (if (not (or (includes (array "true" "false" "none") (value n)) (known scopes (value n)))) (bad (+ "尚未宣告的名稱：" (value n)) n))
        (return none))
      (if (!= (kind n) "list") (return none))
      (let a (form n)) (let h (value (get a 0)))
      (if (includes (array "sum-range" "product-range" "collect-range") h)
        (let spec (rangeSpec n))
        (each bound (slice spec 1 none) (checkExpr bound scopes))
        (let locals (array)) (declare locals (get spec 0))
        (let nested (slice scopes 0 none)) (push nested locals)
        (checkExpr (get a 2) nested) (return none))
      (if (= h "lambda")
        (arity n 2 2) (let locals (array))
        (if (!= (kind (get a 1)) "list") (bad "函式需要參數列。" n))
        (each p (value (get a 1)) (declare locals p))
        (let nested (slice scopes 0 none)) (push nested locals) (checkExpr (get a 2) nested) (return none))
      (if (= h "record")
        (each pair (slice a 1 none) (let p (form pair)) (if (!= (length p) 2) (bad "紀錄需要鍵與值。" pair)) (checkExpr (get p 1) scopes))
        (return none))
      (if (not (or (includes builtin h) (includes (array "array" "choose" "not" "assert-math" "+" "-" "*" "/" "%" "=" "!=" "<" ">" "<=" ">=" "and" "or") h))) (checkExpr (get a 0) scopes))
      (each x (slice a 1 none) (checkExpr x scopes)))
    (fn checkStatement (n scopes local)
      (let a (form n)) (let h (value (get a 0)))
      (if (= h "fn")
        (let params (array))
        (if (!= (kind (get a 2)) "list") (bad "函式需要參數列。" n))
        (each p (value (get a 2)) (declare params p))
        (checkBlock (slice a 3 none) scopes params) (return none))
      (if (= h "let")
        (arity n 2 2) (checkExpr (get a 2) scopes) (declare local (get a 1)) (return none))
      (if (= h "set")
        (arity n 2 2) (checkExpr (get a 1) scopes) (checkExpr (get a 2) scopes) (return none))
      (if (= h "if")
        (checkExpr (get a 1) scopes) (let yes (slice a 2 none)) (let last (get yes (- (length yes) 1)))
        (if (and (!= last none) (= (kind last) "list"))
          (if (and (> (length (value last)) 0) (= (value (get (value last) 0)) "else"))
            (checkBlock (slice (value last) 1 none) scopes (array)) (set yes (slice yes 0 (- (length yes) 1)))))
        (checkBlock yes scopes (array)) (return none))
      (if (= h "while") (checkExpr (get a 1) scopes) (checkBlock (slice a 2 none) scopes (array)) (return none))
      (if (= h "each")
        (checkExpr (get a 2) scopes) (let loopVar (array)) (declare loopVar (get a 1))
        (checkBlock (slice a 3 none) scopes loopVar) (return none))
      (if (or (= h "return") (= h "export")) (checkExpr (get a 1) scopes) (return none))
      (checkExpr n scopes))
    (fn checkBlock (items parent initial)
      (let scopes (slice parent 0 none)) (let local (slice initial 0 none)) (push scopes local)
      (each n items (let a (form n)) (if (= (value (get a 0)) "fn") (declare local (get a 1))))
      (each n items (checkStatement n scopes local))
      (return local))
    (let bindings (array))
    (each n (slice top 2 none) (let a (form n)) (if (= (value (get a 0)) "use") (declare bindings (get a 1))))
    (let exportNode none)
    (each n (slice top 2 none) (if (= (value (get (form n) 0)) "export") (set exportNode n)))
    (let checkedBody (slice body 0 none)) (push checkedBody exportNode)
    (checkBlock checkedBody (array) bindings)

    (let args "") (let params "")
    (each i imports
      (set args (+ args (+ (+ (+ (+ ",typeof module===\"object\"&&module.exports?require(" (json (get i "path"))) "):root[") (json (get i "global"))) "]")))
      (set params (+ params (+ "," (get i "binding")))))
    (return (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ "// Generated by MathScript Web 0.2; edit the .msw source.\n(function(root,factory){const api=factory(typeof module===\"object\"&&module.exports?require(\"../compiler/runtime.js\"):root.MathWebRuntime" args) ");if(typeof module===\"object\"&&module.exports)module.exports=api;else root[") (json moduleName)) "]=api;})(globalThis,function(R") params) "){\"use strict\";\n") (block body false)) "\nreturn R.expose(") exported) ");\n});\n")))
  (export (record ("compile" compile) ("version" "0.2.0"))))
