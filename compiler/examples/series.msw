# Exact integer identities within the IEEE 754 safe-integer range.
(module Series
  (let n 100)
  (let squares (sum-range (k 1 n) (* k k)))
  (let closed (/ (* (* n (+ n 1)) (+ (* 2 n) 1)) 6))
  (assert-math (= squares closed) "平方和公式")
  (let grid (collect-range (x -2 2 0.5) (array x (* x x))))
  (let nested (sum-range (i 1 3) (sum-range (j 1 4) (* i j))))
  (export (record ("squares" squares) ("grid" grid) ("nested" nested))))
